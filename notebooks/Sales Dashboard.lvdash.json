{
  "datasets": [
    {
      "name": "efd7ea43",
      "displayName": "gold daily revenue records",
      "queryLines": [
        "SELECT * FROM workspace.gold.daily_sales"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "Top 10 Customers",
      "config": {
        "version": "1.1",
        "source": "SELECT customer_id, country, lifetime_value FROM workspace.gold.customer_summary ORDER BY lifetime_value DESC LIMIT 10",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id",
            "displayName": "Customer ID"
          },
          {
            "name": "country",
            "expr": "country",
            "displayName": "Country"
          },
          {
            "name": "lifetime_value",
            "expr": "lifetime_value",
            "displayName": "Lifetime Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "event_funnel",
      "displayName": "Event Funnel Stages",
      "config": {
        "source": "workspace.silver.events",
        "measures": [
          {
            "name": "event_count",
            "expr": "COUNT(*)",
            "displayName": "Events",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          }
        ],
        "version": "1.1",
        "comment": "Funnel stage counts (views, carts, purchases) from silver events",
        "dimensions": [
          {
            "name": "stage",
            "expr": "CASE\n  WHEN event_type = 'page_view' THEN 'Views'\n  WHEN event_type = 'add_to_cart' THEN 'Carts'\n  WHEN event_type = 'purchase' THEN 'Purchases'\nEND",
            "displayName": "Funnel Stage"
          }
        ]
      }
    },
    {
      "name": "daily_funnel",
      "displayName": "Daily Funnel by Device",
      "config": {
        "source": "workspace.gold.daily_funnel",
        "measures": [
          {
            "name": "views",
            "expr": "SUM(views)",
            "displayName": "Views",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          },
          {
            "name": "carts",
            "expr": "SUM(carts)",
            "displayName": "Carts",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          },
          {
            "name": "purchases",
            "expr": "SUM(purchases)",
            "displayName": "Purchases",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          },
          {
            "name": "view_to_purchase_rate",
            "expr": "SUM(purchases) / SUM(views)",
            "displayName": "View-to-Purchase Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Daily funnel metrics per device from the gold daily_funnel table",
        "dimensions": [
          {
            "name": "event_date",
            "expr": "event_date",
            "displayName": "Date"
          },
          {
            "name": "device_type",
            "expr": "device_type",
            "displayName": "Device"
          }
        ]
      }
    },
    {
      "name": "top_products",
      "displayName": "Top 10 Products by Views",
      "config": {
        "source": "SELECT e.product_id, p.product_name, COUNT(*) AS views FROM workspace.silver.events e LEFT JOIN workspace.silver.products p\n  ON e.product_id = p.product_id\nWHERE e.event_type = 'page_view' AND e.product_id IS NOT NULL GROUP BY e.product_id, p.product_name ORDER BY views DESC LIMIT 10",
        "measures": [
          {
            "name": "views",
            "expr": "SUM(views)",
            "displayName": "Views",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          }
        ],
        "version": "1.1",
        "comment": "Top 10 products ranked by page views, with product names from the products dimension",
        "dimensions": [
          {
            "name": "product_id",
            "expr": "product_id",
            "displayName": "Product"
          },
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product Name"
          }
        ]
      }
    },
    {
      "name": "category_revenue",
      "displayName": "Revenue by Category",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.product_performance",
        "dimensions": [
          {
            "name": "category",
            "expr": "category",
            "displayName": "Category",
            "comment": "Product category"
          }
        ],
        "measures": [
          {
            "displayName": "Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "revenue",
            "expr": "SUM(revenue)",
            "comment": "Total revenue by category"
          }
        ]
      }
    }
  ],
